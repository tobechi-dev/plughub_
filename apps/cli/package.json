{
  "name": "backkit",
  "version": "0.0.0",
  "private": true,
  "description": "Plughub CLI — add pluggable backend services to your app",
  "type": "module",
  "bin": {
    "backkit": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
