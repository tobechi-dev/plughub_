    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@plughub/core": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
